{
  "version": 2,
  "locale": "hi",
  "survey": {
    "tutor": {
      "name": "FluentAI शिक्षक",
      "subtitle": "आपका व्यक्तिगत अंग्रेज़ी कोच"
    },
    "ui": {
      "show_all_languages": "सभी भाषाएं दिखाएं"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "नमस्ते! 👋 मैं आपका FluentAI शिक्षक हूँ।",
            "audio": ""
          },
          {
            "text": "शुरू करने से पहले — आपका नाम क्या है?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "अपना नाम लिखें…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "आपसे मिलकर अच्छा लगा, {name}! 😊",
            "audio": ""
          },
          {
            "text": "आपकी मातृभाषा क्या है?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "अरबी" },
          { "value": "zh", "emoji": "🇨🇳", "label": "चीनी" },
          { "value": "fr", "emoji": "🇫🇷", "label": "फ्रेंच" },
          { "value": "hi", "emoji": "🇮🇳", "label": "हिंदी" },
          { "value": "ja", "emoji": "🇯🇵", "label": "जापानी" },
          { "value": "ko", "emoji": "🇰🇷", "label": "कोरियाई" },
          { "value": "pt", "emoji": "🇧🇷", "label": "पुर्तगाली" },
          { "value": "ru", "emoji": "🇷🇺", "label": "रूसी" },
          { "value": "es", "emoji": "🇪🇸", "label": "स्पेनिश" },
          { "value": "vi", "emoji": "🇻🇳", "label": "वियतनामी" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "बढ़िया! चलिए शुरू करते हैं 🚀",
            "audio": ""
          },
          {
            "text": "आपका वर्तमान अंग्रेज़ी स्तर क्या है?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "शुरुआती"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "प्रारंभिक"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "मध्यवर्ती"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "उच्च-मध्यवर्ती"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "उन्नत"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "प्रवीण"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "लगभग पूरा हो गया, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "अंग्रेज़ी सीखने का आपका मुख्य लक्ष्य क्या है?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "कार्य और करियर"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "अकादमिक अध्ययन"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "यात्रा और अन्वेषण"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "दैनिक बातचीत"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL परीक्षा"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "आपकी सीखने की प्रोफ़ाइल तैयार है, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "मैं अभी आपके AI शिक्षक अनुभव को वैयक्तिकृत कर रहा हूँ…",
            "audio": ""
          }
        ]
      }
    ]
  }
}