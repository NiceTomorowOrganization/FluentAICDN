{
  "version": 2,
  "locale": "zh",
  "survey": {
    "tutor": {
      "name": "FluentAI导师",
      "subtitle": "您的个人英语教练"
    },
    "ui": {
      "show_all_languages": "显示所有语言"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "您好! 👋 我是您的FluentAI导师。",
            "audio": ""
          },
          {
            "text": "在我们开始之前 — 您叫什么名字？",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "输入您的姓名…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "很高兴认识您，{name}! 😊",
            "audio": ""
          },
          {
            "text": "您的母语是什么？",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "阿拉伯语" },
          { "value": "zh", "emoji": "🇨🇳", "label": "中文" },
          { "value": "fr", "emoji": "🇫🇷", "label": "法语" },
          { "value": "hi", "emoji": "🇮🇳", "label": "印地语" },
          { "value": "ja", "emoji": "🇯🇵", "label": "日语" },
          { "value": "ko", "emoji": "🇰🇷", "label": "韩语" },
          { "value": "pt", "emoji": "🇧🇷", "label": "葡萄牙语" },
          { "value": "ru", "emoji": "🇷🇺", "label": "俄语" },
          { "value": "es", "emoji": "🇪🇸", "label": "西班牙语" },
          { "value": "vi", "emoji": "🇻🇳", "label": "越南语" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "好的！我们开始吧 🚀",
            "audio": ""
          },
          {
            "text": "您当前的英语水平如何？",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "初学者"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "基础"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "中级"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "中高级"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "高级"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "精通"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "快完成了，{name}! 🚀",
            "audio": ""
          },
          {
            "text": "您学习英语的主要目标是什么？",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "工作与职业"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "学术研究"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "旅游与探索"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "日常对话"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL考试"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "您的学习档案已准备好，{name}! 🎉",
            "audio": ""
          },
          {
            "text": "我正在为您个性化AI导师体验…",
            "audio": ""
          }
        ]
      }
    ]
  }
}