{
  "version": 2,
  "locale": "ru",
  "survey": {
    "tutor": {
      "name": "FluentAI Репетитор",
      "subtitle": "Ваш личный тренер по английскому"
    },
    "ui": {
      "show_all_languages": "Показать все языки"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Привет! 👋 Я ваш FluentAI Репетитор.",
            "audio": ""
          },
          {
            "text": "Прежде чем начать — как вас зовут?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Введите ваше имя…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Приятно познакомиться, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Какой ваш родной язык?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Арабский" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Китайский" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Французский" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Хинди" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Японский" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Корейский" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Португальский" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Русский" },
          { "value": "es", "emoji": "🇪🇸", "label": "Испанский" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Вьетнамский" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Отлично! Начнём 🚀",
            "audio": ""
          },
          {
            "text": "Какой ваш текущий уровень английского?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Начинающий"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Базовый"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Средний"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Выше среднего"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Продвинутый"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Свободное владение"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Почти готово, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "Какова ваша главная цель изучения английского?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Работа и карьера"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Академическое изучение"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Путешествия и исследования"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Повседневный разговор"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Экзамен IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Ваш профиль обучения готов, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Я персонализирую ваш опыт ИИ-репетитора прямо сейчас…",
            "audio": ""
          }
        ]
      }
    ]
  }
}