{
  "version": 2,
  "locale": "in",
  "survey": {
    "tutor": {
      "name": "Tutor FluentAI",
      "subtitle": "Pelatih bahasa Inggris pribadi Anda"
    },
    "ui": {
      "show_all_languages": "Tampilkan semua bahasa"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Halo! 👋 Saya tutor FluentAI Anda.",
            "audio": "data/survey/audio/in/intro_step_1.wav"
          },
          {
            "text": "Sebelum kita mulai — siapa nama Anda?",
            "audio": "data/survey/audio/in/intro_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Ketik nama Anda…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Senang bertemu Anda, {name}! 😊",
            "audio": "data/survey/audio/in/after_name_step_1.wav"
          },
          {
            "text": "Apa tingkat bahasa Inggris Anda saat ini?",
            "audio": "data/survey/audio/in/after_name_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Pemula"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Dasar"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Menengah"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Menengah-atas"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Mahir"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Sangat mahir"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hampir selesai, {name}! 🚀",
            "audio": "data/survey/audio/in/after_level_step_1.wav"
          },
          {
            "text": "Apa tujuan utama Anda belajar bahasa Inggris?",
            "audio": "data/survey/audio/in/after_level_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Pekerjaan & karier"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Studi akademik"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Perjalanan & eksplorasi"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Percakapan sehari-hari"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Ujian IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Profil belajar Anda siap, {name}! 🎉",
            "audio": "data/survey/audio/in/done_step_1.wav"
          },
          {
            "text": "Saya sedang mempersonalisasi pengalaman tutor AI Anda…",
            "audio": "data/survey/audio/in/done_step_2.wav"
          }
        ]
      }
    ]
  }
}