{
  "version": 2,
  "locale": "tr",
  "survey": {
    "tutor": {
      "name": "FluentAI Eğitmeni",
      "subtitle": "Kişisel İngilizce koçunuz"
    },
    "ui": {
      "show_all_languages": "Tüm dilleri göster"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Merhaba! 👋 Ben FluentAI Eğitmeninizim.",
            "audio": ""
          },
          {
            "text": "Başlamadan önce — adınız nedir?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Adınızı yazın…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Tanıştığımıza memnun oldum, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Ana diliniz nedir?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Arapça" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Çince" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Fransızca" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Hintçe" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Japonca" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Korece" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Portekizce" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Rusça" },
          { "value": "es", "emoji": "🇪🇸", "label": "İspanyolca" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Vietnamca" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Harika! Başlayalım 🚀",
            "audio": ""
          },
          {
            "text": "Mevcut İngilizce seviyeniz nedir?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Başlangıç"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Temel"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Orta"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Orta-Üst"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "İleri"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Uzman"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Neredeyse bitti, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "İngilizce öğrenmek için ana hedefiniz nedir?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "İş ve Kariyer"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Akademik Çalışma"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Seyahat ve Keşif"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Günlük Konuşma"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL Sınavı"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Öğrenme profiliniz hazır, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "YZ eğitmen deneyiminizi şimdi kişiselleştiriyorum…",
            "audio": ""
          }
        ]
      }
    ]
  }
}