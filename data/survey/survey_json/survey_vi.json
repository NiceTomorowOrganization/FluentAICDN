{
  "version": 2,
  "locale": "vi",
  "survey": {
    "tutor": {
      "name": "FluentAI Tutor",
      "subtitle": "Huấn luyện viên tiếng Anh cá nhân"
    },
    "ui": {
      "show_all_languages": "Hiện tất cả ngôn ngữ"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Xin chào! 👋 Tôi là gia sư FluentAI của bạn.",
            "audio": "data/survey/audio/vi/intro_step_1.wav"
          },
          {
            "text": "Trước khi bắt đầu — tên bạn là gì?",
            "audio": "data/survey/audio/vi/intro_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Nhập tên của bạn…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Rất vui được gặp bạn, {name}! 😊",
            "audio": "data/survey/audio/vi/after_name_step_1.wav"
          },
          {
            "text": "Trình độ tiếng Anh hiện tại của bạn?",
            "audio": "data/survey/audio/vi/after_name_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Mới bắt đầu"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Cơ bản"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Trung cấp"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Trung cao cấp"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Nâng cao"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Thành thạo"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Sắp xong rồi, {name}! 🚀",
            "audio": "data/survey/audio/vi/after_level_step_1.wav"
          },
          {
            "text": "Mục tiêu chính khi học tiếng Anh của bạn là gì?",
            "audio": "data/survey/audio/vi/after_level_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Công việc & Sự nghiệp"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Học thuật"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Du lịch & Khám phá"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Hội thoại hàng ngày"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Kỳ thi IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hồ sơ học tập của bạn đã sẵn sàng, {name}! 🎉",
            "audio": "data/survey/audio/vi/done_step_1.wav"
          },
          {
            "text": "Tôi đang cá nhân hoá trải nghiệm gia sư AI cho bạn…",
            "audio": "data/survey/audio/vi/done_step_2.wav"
          }
        ]
      }
    ]
  }
}