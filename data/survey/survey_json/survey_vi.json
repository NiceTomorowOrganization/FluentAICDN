{
  "version": 2,
  "locale": "vi",
  "survey": {
    "tutor": {
      "name": "FluentAI Tutor",
      "subtitle": "Huấn luyện viên tiếng Anh cá nhân"
    },
    "ui": {
      "show_all_languages": "Hiện tất cả ngôn ngữ"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Xin chào! 👋 Tôi là gia sư FluentAI của bạn.",
            "audio": ""
          },
          {
            "text": "Trước khi bắt đầu — tên bạn là gì?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Nhập tên của bạn…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Rất vui được gặp bạn, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Ngôn ngữ mẹ đẻ của bạn là gì?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Tiếng Ả Rập" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Tiếng Trung" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Tiếng Pháp" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Tiếng Hindi" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Tiếng Nhật" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Tiếng Hàn" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Tiếng Bồ Đào Nha" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Tiếng Nga" },
          { "value": "es", "emoji": "🇪🇸", "label": "Tiếng Tây Ban Nha" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Tiếng Việt" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Được rồi! Hãy bắt đầu thôi 🚀",
            "audio": ""
          },
          {
            "text": "Trình độ tiếng Anh hiện tại của bạn?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Mới bắt đầu"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Cơ bản"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Trung cấp"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Trung cao cấp"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Nâng cao"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Thành thạo"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Sắp xong rồi, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "Mục tiêu chính khi học tiếng Anh của bạn là gì?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Công việc & Sự nghiệp"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Học thuật"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Du lịch & Khám phá"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Hội thoại hàng ngày"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Kỳ thi IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hồ sơ học tập của bạn đã sẵn sàng, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Tôi đang cá nhân hoá trải nghiệm gia sư AI cho bạn…",
            "audio": ""
          }
        ]
      }
    ]
  }
}