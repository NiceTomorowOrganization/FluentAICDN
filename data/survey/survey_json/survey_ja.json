{
  "version": 2,
  "locale": "ja",
  "survey": {
    "tutor": {
      "name": "FluentAIチューター",
      "subtitle": "あなた専用の英語コーチ"
    },
    "ui": {
      "show_all_languages": "すべての言語を表示"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "こんにちは! 👋 私はあなたのFluentAIチューターです。",
            "audio": ""
          },
          {
            "text": "始める前に — お名前は何ですか?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "名前を入力…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "はじめまして、{name}さん! 😊",
            "audio": ""
          },
          {
            "text": "母国語は何ですか?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "アラビア語" },
          { "value": "zh", "emoji": "🇨🇳", "label": "中国語" },
          { "value": "fr", "emoji": "🇫🇷", "label": "フランス語" },
          { "value": "hi", "emoji": "🇮🇳", "label": "ヒンディー語" },
          { "value": "ja", "emoji": "🇯🇵", "label": "日本語" },
          { "value": "ko", "emoji": "🇰🇷", "label": "韓国語" },
          { "value": "pt", "emoji": "🇧🇷", "label": "ポルトガル語" },
          { "value": "ru", "emoji": "🇷🇺", "label": "ロシア語" },
          { "value": "es", "emoji": "🇪🇸", "label": "スペイン語" },
          { "value": "vi", "emoji": "🇻🇳", "label": "ベトナム語" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "さあ、始めましょう! 🚀",
            "audio": ""
          },
          {
            "text": "現在の英語レベルはどれくらいですか?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "初心者"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "初級"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "中級"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "中上級"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "上級"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "熟達"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "もうすぐ完了です、{name}さん! 🚀",
            "audio": ""
          },
          {
            "text": "英語を学ぶ主な目的は何ですか?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "仕事とキャリア"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "学術研究"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "旅行と探検"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "日常会話"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL試験"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "学習プロフィールの準備ができました、{name}さん! 🎉",
            "audio": ""
          },
          {
            "text": "AIチューター体験をパーソナライズしています…",
            "audio": ""
          }
        ]
      }
    ]
  }
}