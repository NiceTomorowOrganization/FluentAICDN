{
  "version": 2,
  "locale": "de",
  "survey": {
    "tutor": {
      "name": "FluentAI-Tutor",
      "subtitle": "Ihr persönlicher Englisch-Coach"
    },
    "ui": {
      "show_all_languages": "Alle Sprachen anzeigen"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hallo! 👋 Ich bin Ihr FluentAI-Tutor.",
            "audio": "data/survey/audio/de/intro_step_1.wav"
          },
          {
            "text": "Bevor wir beginnen — wie heißen Sie?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Geben Sie Ihren Namen ein…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Schön Sie kennenzulernen, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Was ist Ihre Muttersprache?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          {
            "value": "ar",
            "emoji": "🇸🇦",
            "label": "Arabisch"
          },
          {
            "value": "zh",
            "emoji": "🇨🇳",
            "label": "Chinesisch"
          },
          {
            "value": "fr",
            "emoji": "🇫🇷",
            "label": "Französisch"
          },
          {
            "value": "hi",
            "emoji": "🇮🇳",
            "label": "Hindi"
          },
          {
            "value": "ja",
            "emoji": "🇯🇵",
            "label": "Japanisch"
          },
          {
            "value": "ko",
            "emoji": "🇰🇷",
            "label": "Koreanisch"
          },
          {
            "value": "pt",
            "emoji": "🇧🇷",
            "label": "Portugiesisch"
          },
          {
            "value": "ru",
            "emoji": "🇷🇺",
            "label": "Russisch"
          },
          {
            "value": "es",
            "emoji": "🇪🇸",
            "label": "Spanisch"
          },
          {
            "value": "vi",
            "emoji": "🇻🇳",
            "label": "Vietnamesisch"
          }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Gut! Los geht's 🚀",
            "audio": ""
          },
          {
            "text": "Wie ist Ihr aktuelles Englischniveau?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Anfänger"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Grundkenntnisse"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Mittelstufe"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Obere Mittelstufe"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Fortgeschritten"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Beherrschung"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Fast fertig, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "Was ist Ihr Hauptziel beim Englischlernen?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Beruf und Karriere"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Akademisches Studium"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Reisen und Erkundung"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Alltagsgespräche"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL Prüfung"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Ihr Lernprofil ist bereit, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Ich personalisiere jetzt Ihre KI-Tutor-Erfahrung…",
            "audio": ""
          }
        ]
      }
    ]
  }
}