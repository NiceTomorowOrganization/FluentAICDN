{
  "version": 2,
  "locale": "th",
  "survey": {
    "tutor": {
      "name": "ติวเตอร์ FluentAI",
      "subtitle": "โค้ชภาษาอังกฤษส่วนตัวของคุณ"
    },
    "ui": {
      "show_all_languages": "แสดงทุกภาษา"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "สวัสดี! 👋 ฉันคือติวเตอร์ FluentAI ของคุณ",
            "audio": ""
          },
          {
            "text": "ก่อนเริ่ม — คุณชื่ออะไร?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "พิมพ์ชื่อของคุณ…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "ยินดีที่ได้รู้จัก, {name}! 😊",
            "audio": ""
          },
          {
            "text": "ภาษาแม่ของคุณคืออะไร?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "อาหรับ" },
          { "value": "zh", "emoji": "🇨🇳", "label": "จีน" },
          { "value": "fr", "emoji": "🇫🇷", "label": "ฝรั่งเศส" },
          { "value": "hi", "emoji": "🇮🇳", "label": "ฮินดี" },
          { "value": "ja", "emoji": "🇯🇵", "label": "ญี่ปุ่น" },
          { "value": "ko", "emoji": "🇰🇷", "label": "เกาหลี" },
          { "value": "pt", "emoji": "🇧🇷", "label": "โปรตุเกส" },
          { "value": "ru", "emoji": "🇷🇺", "label": "รัสเซีย" },
          { "value": "es", "emoji": "🇪🇸", "label": "สเปน" },
          { "value": "vi", "emoji": "🇻🇳", "label": "เวียดนาม" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "เยี่ยม! เริ่มกันเลย 🚀",
            "audio": ""
          },
          {
            "text": "ระดับภาษาอังกฤษปัจจุบันของคุณคืออะไร?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "ผู้เริ่มต้น"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "พื้นฐาน"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "ปานกลาง"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "ปานกลาง-สูง"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "สูง"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "เชี่ยวชาญ"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "เกือบเสร็จแล้ว, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "เป้าหมายหลักของคุณในการเรียนภาษาอังกฤษคืออะไร?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "การทำงานและอาชีพ"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "การศึกษาทางวิชาการ"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "การท่องเที่ยวและสำรวจ"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "การสนทนาประจำวัน"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "การสอบ IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "โปรไฟล์การเรียนของคุณพร้อมแล้ว, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "ฉันกำลังปรับแต่งประสบการณ์ติวเตอร์ AI สำหรับคุณ…",
            "audio": ""
          }
        ]
      }
    ]
  }
}