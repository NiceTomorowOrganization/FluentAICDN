{
  "version": 2,
  "locale": "es",
  "survey": {
    "tutor": {
      "name": "Tutor FluentAI",
      "subtitle": "Tu coach personal de inglés"
    },
    "ui": {
      "show_all_languages": "Mostrar todos los idiomas"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "¡Hola! 👋 Soy tu Tutor FluentAI.",
            "audio": ""
          },
          {
            "text": "Antes de empezar, ¿cuál es tu nombre?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Escribe tu nombre…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "¡Encantado de conocerte, {name}! 😊",
            "audio": ""
          },
          {
            "text": "¿Cuál es tu idioma nativo?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Árabe" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Chino" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Francés" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Hindi" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Japonés" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Coreano" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Portugués" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Ruso" },
          { "value": "es", "emoji": "🇪🇸", "label": "Español" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Vietnamita" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "¡Vamos! 🚀",
            "audio": ""
          },
          {
            "text": "¿Cuál es tu nivel actual de inglés?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Principiante"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Elemental"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Intermedio"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Intermedio-Alto"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Avanzado"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Competente"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "¡Casi listo, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "¿Cuál es tu objetivo principal al aprender inglés?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Trabajo y carrera"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Estudio académico"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Viajes y exploración"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Conversación diaria"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Examen IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "¡Tu perfil de aprendizaje está listo, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Estoy personalizando tu experiencia de tutor IA ahora…",
            "audio": ""
          }
        ]
      }
    ]
  }
}