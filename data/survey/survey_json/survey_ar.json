{
  "version": 2,
  "locale": "ar",
  "survey": {
    "tutor": {
      "name": "مدرس FluentAI",
      "subtitle": "مدربك الإنجليزي الشخصي"
    },
    "ui": {
      "show_all_languages": "إظهار جميع اللغات"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          "مرحبًا! 👋 أنا مدرسك FluentAI.",
          "قبل أن نبدأ — ما اسمك؟"
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "اكتب اسمك…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          "سعيد بلقائك، {name}! 😊",
          "ما هو مستواك الحالي في اللغة الإنجليزية؟"
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          { "value": "A1", "label": "A1", "description": "مبتدئ" },
          { "value": "A2", "label": "A2", "description": "ابتدائي" },
          { "value": "B1", "label": "B1", "description": "متوسط" },
          { "value": "B2", "label": "B2", "description": "متوسط فوق" },
          { "value": "C1", "label": "C1", "description": "متقدم" },
          { "value": "C2", "label": "C2", "description": "إتقان" }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          "قاربنا على الانتهاء، {name}! 🚀",
          "ما هو هدفك الرئيسي من تعلم الإنجليزية؟"
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          { "value": "work",   "emoji": "💼", "label": "العمل والمهنة" },
          { "value": "study",  "emoji": "📚", "label": "الدراسة الأكاديمية" },
          { "value": "travel", "emoji": "✈️", "label": "السفر والاستكشاف" },
          { "value": "daily",  "emoji": "💬", "label": "المحادثة اليومية" },
          { "value": "ielts",  "emoji": "🎯", "label": "امتحان IELTS / TOEFL" }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          "ملف التعلم الخاص بك جاهز، {name}! 🎉",
          "أقوم بتخصيص تجربة المدرس الذكي لك الآن…"
        ]
      }
    ]
  }
}
