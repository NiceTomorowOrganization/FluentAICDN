{
  "version": 2,
  "locale": "ar",
  "survey": {
    "tutor": {
      "name": "مدرس FluentAI",
      "subtitle": "مدربك الإنجليزي الشخصي"
    },
    "ui": {
      "show_all_languages": "إظهار جميع اللغات"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "مرحبًا! 👋 أنا مدرسك FluentAI.",
            "audio": "data/survey/audio/ar/intro_step_1.wav"
          },
          {
            "text": "قبل أن نبدأ — ما اسمك؟",
            "audio": "data/survey/audio/ar/intro_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "اكتب اسمك…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "سعيد بلقائك، {name}! 😊",
            "audio": "data/survey/audio/ar/after_name_step_1.wav"
          },
          {
            "text": "ما هو مستواك الحالي في اللغة الإنجليزية؟",
            "audio": "data/survey/audio/ar/after_name_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "مبتدئ"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "ابتدائي"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "متوسط"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "متوسط فوق"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "متقدم"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "إتقان"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "قاربنا على الانتهاء، {name}! 🚀",
            "audio": "data/survey/audio/ar/after_level_step_1.wav"
          },
          {
            "text": "ما هو هدفك الرئيسي من تعلم الإنجليزية؟",
            "audio": "data/survey/audio/ar/after_level_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "العمل والمهنة"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "الدراسة الأكاديمية"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "السفر والاستكشاف"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "المحادثة اليومية"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "امتحان IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "ملف التعلم الخاص بك جاهز، {name}! 🎉",
            "audio": "data/survey/audio/ar/done_step_1.wav"
          },
          {
            "text": "أقوم بتخصيص تجربة المدرس الذكي لك الآن…",
            "audio": "data/survey/audio/ar/done_step_2.wav"
          }
        ]
      }
    ]
  }
}