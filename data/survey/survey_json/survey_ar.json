{
  "version": 2,
  "locale": "ar",
  "survey": {
    "tutor": {
      "name": "مدرس FluentAI",
      "subtitle": "مدربك الإنجليزي الشخصي"
    },
    "ui": {
      "show_all_languages": "إظهار جميع اللغات"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "مرحبًا! 👋 أنا مدرسك FluentAI.",
            "audio": ""
          },
          {
            "text": "قبل أن نبدأ — ما اسمك؟",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "اكتب اسمك…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "سعيد بلقائك، {name}! 😊",
            "audio": ""
          },
          {
            "text": "ما هي لغتك الأم؟",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "العربية" },
          { "value": "zh", "emoji": "🇨🇳", "label": "الصينية" },
          { "value": "fr", "emoji": "🇫🇷", "label": "الفرنسية" },
          { "value": "hi", "emoji": "🇮🇳", "label": "الهندية" },
          { "value": "ja", "emoji": "🇯🇵", "label": "اليابانية" },
          { "value": "ko", "emoji": "🇰🇷", "label": "الكورية" },
          { "value": "pt", "emoji": "🇧🇷", "label": "البرتغالية" },
          { "value": "ru", "emoji": "🇷🇺", "label": "الروسية" },
          { "value": "es", "emoji": "🇪🇸", "label": "الإسبانية" },
          { "value": "vi", "emoji": "🇻🇳", "label": "الفيتنامية" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "حسناً! لنبدأ 🚀",
            "audio": ""
          },
          {
            "text": "ما هو مستواك الحالي في اللغة الإنجليزية؟",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "مبتدئ"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "ابتدائي"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "متوسط"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "متوسط فوق"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "متقدم"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "إتقان"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "قاربنا على الانتهاء، {name}! 🚀",
            "audio": ""
          },
          {
            "text": "ما هو هدفك الرئيسي من تعلم الإنجليزية؟",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "العمل والمهنة"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "الدراسة الأكاديمية"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "السفر والاستكشاف"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "المحادثة اليومية"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "امتحان IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "ملف التعلم الخاص بك جاهز، {name}! 🎉",
            "audio": ""
          },
          {
            "text": "أقوم بتخصيص تجربة المدرس الذكي لك الآن…",
            "audio": ""
          }
        ]
      }
    ]
  }
}