{
  "version": 2,
  "locale": "uz",
  "survey": {
    "tutor": {
      "name": "FluentAI o'qituvchi",
      "subtitle": "Sizning shaxsiy ingliz tili murabbiyingiz"
    },
    "ui": {
      "show_all_languages": "Barcha tillarni ko'rsatish"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Salom! 👋 Men sizning FluentAI o'qituvchingizman.",
            "audio": ""
          },
          {
            "text": "Boshlashdan oldin — ismingiz nima?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Ismingizni yozing…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Tanishganimdan xursandman, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Ona tilingiz qaysi?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Arabcha" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Xitoycha" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Fransuzcha" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Hindcha" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Yaponcha" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Koreyscha" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Portugalcha" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Ruscha" },
          { "value": "es", "emoji": "🇪🇸", "label": "Ispancha" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Vyetnamcha" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Ajoyib! Boshlaylik 🚀",
            "audio": ""
          },
          {
            "text": "Hozirgi ingliz tili darajangiz qanday?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Boshlovchi"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Boshlang'ich"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "O'rta"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "O'rta-yuqori"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Yuqori"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Mukammal"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Deyarli tugadi, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "Ingliz tilini o'rganishdan asosiy maqsadingiz nima?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Ish & karyera"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Akademik o'qish"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Sayohat & tadqiqot"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Kundalik suhbatlar"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL imtihoni"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "O'rganish profilingiz tayyor, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Hozir AI o'qituvchi tajribangizni shaxsiylashtiryapman…",
            "audio": ""
          }
        ]
      }
    ]
  }
}