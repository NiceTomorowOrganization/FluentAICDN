{
  "version": 2,
  "locale": "nl",
  "survey": {
    "tutor": {
      "name": "FluentAI Tutor",
      "subtitle": "Je persoonlijke Engelse coach"
    },
    "ui": {
      "show_all_languages": "Toon alle talen"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          "Hallo! 👋 Ik ben je FluentAI tutor.",
          "Voor we beginnen — wat is je naam?"
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Typ je naam…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          "Leuk je te ontmoeten, {name}! 😊",
          "Wat is je huidige Engelse niveau?"
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          { "value": "A1", "label": "A1", "description": "Beginner" },
          { "value": "A2", "label": "A2", "description": "Elementair" },
          { "value": "B1", "label": "B1", "description": "Gemiddeld" },
          { "value": "B2", "label": "B2", "description": "Hoger gemiddeld" },
          { "value": "C1", "label": "C1", "description": "Gevorderd" },
          { "value": "C2", "label": "C2", "description": "Vaardig" }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          "Bijna klaar, {name}! 🚀",
          "Wat is je hoofddoel met Engels leren?"
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          { "value": "work",   "emoji": "💼", "label": "Werk & carrière" },
          { "value": "study",  "emoji": "📚", "label": "Academische studie" },
          { "value": "travel", "emoji": "✈️", "label": "Reizen & ontdekken" },
          { "value": "daily",  "emoji": "💬", "label": "Dagelijkse gesprekken" },
          { "value": "ielts",  "emoji": "🎯", "label": "IELTS / TOEFL examen" }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          "Je leerprofiel is klaar, {name}! 🎉",
          "Ik personaliseer nu je AI-tutor ervaring…"
        ]
      }
    ]
  }
}
