{
  "version": 2,
  "locale": "nl",
  "survey": {
    "tutor": {
      "name": "FluentAI Tutor",
      "subtitle": "Je persoonlijke Engelse coach"
    },
    "ui": {
      "show_all_languages": "Toon alle talen"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hallo! 👋 Ik ben je FluentAI tutor.",
            "audio": ""
          },
          {
            "text": "Voor we beginnen — wat is je naam?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Typ je naam…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Leuk je te ontmoeten, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Wat is je moedertaal?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Arabisch" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Chinees" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Frans" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Hindi" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Japans" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Koreaans" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Portugees" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Russisch" },
          { "value": "es", "emoji": "🇪🇸", "label": "Spaans" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Vietnamees" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Geweldig! Laten we beginnen 🚀",
            "audio": ""
          },
          {
            "text": "Wat is je huidige Engelse niveau?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Beginner"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Elementair"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Gemiddeld"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Hoger gemiddeld"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Gevorderd"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Vaardig"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Bijna klaar, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "Wat is je hoofddoel met Engels leren?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Werk & carrière"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Academische studie"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Reizen & ontdekken"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Dagelijkse gesprekken"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL examen"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Je leerprofiel is klaar, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Ik personaliseer nu je AI-tutor ervaring…",
            "audio": ""
          }
        ]
      }
    ]
  }
}