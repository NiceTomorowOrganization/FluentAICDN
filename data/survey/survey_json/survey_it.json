{
  "version": 2,
  "locale": "it",
  "survey": {
    "tutor": {
      "name": "Tutor FluentAI",
      "subtitle": "Il tuo coach personale di inglese"
    },
    "ui": {
      "show_all_languages": "Mostra tutte le lingue"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Ciao! 👋 Sono il tuo Tutor FluentAI.",
            "audio": ""
          },
          {
            "text": "Prima di iniziare — come ti chiami?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Inserisci il tuo nome…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Piacere di conoscerti, {name}! 😊",
            "audio": ""
          },
          {
            "text": "Qual è la tua lingua madre?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          { "value": "ar", "emoji": "🇸🇦", "label": "Arabo" },
          { "value": "zh", "emoji": "🇨🇳", "label": "Cinese" },
          { "value": "fr", "emoji": "🇫🇷", "label": "Francese" },
          { "value": "hi", "emoji": "🇮🇳", "label": "Hindi" },
          { "value": "ja", "emoji": "🇯🇵", "label": "Giapponese" },
          { "value": "ko", "emoji": "🇰🇷", "label": "Coreano" },
          { "value": "pt", "emoji": "🇧🇷", "label": "Portoghese" },
          { "value": "ru", "emoji": "🇷🇺", "label": "Russo" },
          { "value": "es", "emoji": "🇪🇸", "label": "Spagnolo" },
          { "value": "vi", "emoji": "🇻🇳", "label": "Vietnamita" }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Ottimo! Iniziamo 🚀",
            "audio": ""
          },
          {
            "text": "Qual è il tuo livello attuale di inglese?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Principiante"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Elementare"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Intermedio"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Intermedio-Avanzato"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Avanzato"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Padronanza"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Quasi finito, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "Qual è il tuo obiettivo principale per imparare l'inglese?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Lavoro e carriera"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Studio accademico"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Viaggi ed esplorazione"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Conversazione quotidiana"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Esame IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Il tuo profilo di apprendimento è pronto, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "Sto personalizzando la tua esperienza di tutor AI ora…",
            "audio": ""
          }
        ]
      }
    ]
  }
}