{
  "version": 2,
  "locale": "it",
  "survey": {
    "tutor": {
      "name": "Tutor FluentAI",
      "subtitle": "Il tuo coach personale di inglese"
    },
    "ui": {
      "show_all_languages": "Mostra tutte le lingue"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Ciao! 👋 Sono il tuo Tutor FluentAI.",
            "audio": "data/survey/audio/it/intro_step_1.wav"
          },
          {
            "text": "Prima di iniziare — come ti chiami?",
            "audio": "data/survey/audio/it/intro_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Inserisci il tuo nome…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Piacere di conoscerti, {name}! 😊",
            "audio": "data/survey/audio/it/after_name_step_1.wav"
          },
          {
            "text": "Qual è il tuo livello attuale di inglese?",
            "audio": "data/survey/audio/it/after_name_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Principiante"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Elementare"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Intermedio"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Intermedio-Avanzato"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Avanzato"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Padronanza"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Quasi finito, {name}! 🚀",
            "audio": "data/survey/audio/it/after_level_step_1.wav"
          },
          {
            "text": "Qual è il tuo obiettivo principale per imparare l'inglese?",
            "audio": "data/survey/audio/it/after_level_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Lavoro e carriera"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Studio accademico"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Viaggi ed esplorazione"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Conversazione quotidiana"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "Esame IELTS / TOEFL"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Il tuo profilo di apprendimento è pronto, {name}! 🎉",
            "audio": "data/survey/audio/it/done_step_1.wav"
          },
          {
            "text": "Sto personalizzando la tua esperienza di tutor AI ora…",
            "audio": "data/survey/audio/it/done_step_2.wav"
          }
        ]
      }
    ]
  }
}