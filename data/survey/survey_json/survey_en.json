{
  "version": 2,
  "locale": "en",
  "survey": {
    "tutor": {
      "name": "FluentAI Tutor",
      "subtitle": "Your personal English coach"
    },
    "ui": {
      "show_all_languages": "Show all languages"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hey there! 👋 I'm your FluentAI Tutor.",
            "audio": "data/survey/audio/en/intro_step_1.wav"
          },
          {
            "text": "Before we begin — what's your name?",
            "audio": "data/survey/audio/en/intro_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Type your name…",
        "save_as": "name"
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Nice to meet you, {name}! 😊",
            "audio": "data/survey/audio/en/after_name_step_1.wav"
          },
          {
            "text": "What's your current English level?",
            "audio": "data/survey/audio/en/after_name_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Beginner"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Elementary"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Intermediate"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Upper-Intermediate"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Advanced"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Proficient"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Almost done, {name}! 🚀",
            "audio": "data/survey/audio/en/after_level_step_1.wav"
          },
          {
            "text": "What's your main goal for learning English?",
            "audio": "data/survey/audio/en/after_level_step_2.wav"
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Work & Career"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Academic Study"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Travel & Exploration"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Daily Conversation"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL Exam"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Your learning profile is ready, {name}! 🎉",
            "audio": "data/survey/audio/en/done_step_1.wav"
          },
          {
            "text": "I'm personalizing your AI tutor experience now…",
            "audio": "data/survey/audio/en/done_step_2.wav"
          }
        ]
      }
    ]
  }
}