{
  "version": 2,
  "locale": "en",
  "survey": {
    "tutor": {
      "name": "FluentAI Tutor",
      "subtitle": "Your personal English coach"
    },
    "ui": {
      "show_all_languages": "Show all languages"
    },
    "steps": [
      {
        "id": "intro",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Hey there! 👋 I'm your FluentAI Tutor.",
            "audio": ""
          },
          {
            "text": "Before we begin — what's your name?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_name",
        "type": "text_input",
        "placeholder": "Type your name…",
        "save_as": "name"
      },
      {
        "id": "ask_native_language",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Nice to meet you, {name}! 😊",
            "audio": ""
          },
          {
            "text": "What's your native language?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_native_language",
        "type": "single_choice",
        "save_as": "native_language",
        "options": [
          {
            "value": "ar",
            "emoji": "🇸🇦",
            "label": "Arabic"
          },
          {
            "value": "zh",
            "emoji": "🇨🇳",
            "label": "Chinese"
          },
          {
            "value": "fr",
            "emoji": "🇫🇷",
            "label": "French"
          },
          {
            "value": "hi",
            "emoji": "🇮🇳",
            "label": "Hindi"
          },
          {
            "value": "ja",
            "emoji": "🇯🇵",
            "label": "Japanese"
          },
          {
            "value": "ko",
            "emoji": "🇰🇷",
            "label": "Korean"
          },
          {
            "value": "pt",
            "emoji": "🇧🇷",
            "label": "Portuguese"
          },
          {
            "value": "ru",
            "emoji": "🇷🇺",
            "label": "Russian"
          },
          {
            "value": "es",
            "emoji": "🇪🇸",
            "label": "Spanish"
          },
          {
            "value": "vi",
            "emoji": "🇻🇳",
            "label": "Vietnamese"
          }
        ]
      },
      {
        "id": "after_name",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Got it! Let's get started 🚀",
            "audio": ""
          },
          {
            "text": "What's your current English level?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_level",
        "type": "single_choice",
        "save_as": "english_level",
        "options": [
          {
            "value": "A1",
            "label": "A1",
            "description": "Beginner"
          },
          {
            "value": "A2",
            "label": "A2",
            "description": "Elementary"
          },
          {
            "value": "B1",
            "label": "B1",
            "description": "Intermediate"
          },
          {
            "value": "B2",
            "label": "B2",
            "description": "Upper-Intermediate"
          },
          {
            "value": "C1",
            "label": "C1",
            "description": "Advanced"
          },
          {
            "value": "C2",
            "label": "C2",
            "description": "Proficient"
          }
        ]
      },
      {
        "id": "after_level",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Almost done, {name}! 🚀",
            "audio": ""
          },
          {
            "text": "What's your main goal for learning English?",
            "audio": ""
          }
        ]
      },
      {
        "id": "collect_goal",
        "type": "single_choice",
        "save_as": "learning_goal",
        "options": [
          {
            "value": "work",
            "emoji": "💼",
            "label": "Work & Career"
          },
          {
            "value": "study",
            "emoji": "📚",
            "label": "Academic Study"
          },
          {
            "value": "travel",
            "emoji": "✈️",
            "label": "Travel & Exploration"
          },
          {
            "value": "daily",
            "emoji": "💬",
            "label": "Daily Conversation"
          },
          {
            "value": "ielts",
            "emoji": "🎯",
            "label": "IELTS / TOEFL Exam"
          }
        ]
      },
      {
        "id": "done",
        "type": "tutor_messages",
        "messages": [
          {
            "text": "Your learning profile is ready, {name}! 🎉",
            "audio": ""
          },
          {
            "text": "I'm personalizing your AI tutor experience now…",
            "audio": ""
          }
        ]
      }
    ]
  }
}